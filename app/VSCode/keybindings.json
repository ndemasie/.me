// Place your key bindings in this file to override the defaults
[
  {
    "key": "ctrl+shift+alt+cmd+f",
    "command": "workbench.action.findInFiles",
    "args": {
      "filesToInclude": "${workspaceFolder}/",
      "triggerSearch": false
    },
    "when": "editorTextFocus"
  },
  {
    "key": "ctrl+n",
    "command": "explorer.newFile",
    "when": "!editorFocus && !inQuickOpen"
  },
  {
    "key": "ctrl+shift+n",
    "command": "explorer.newFolder",
    "when": "!editorFocus"
  },
  {
    "key": "ctrl+shift+alt+cmd+=",
    "command": "workbench.action.increaseViewSize"
  },
  {
    "key": "ctrl+shift+alt+cmd+-",
    "command": "workbench.action.decreaseViewSize"
  },
  {
    "key": "ctrl+shift+alt+cmd+s",
    "command": "cSpell.suggestSpellingCorrections"
  },
  {
    "key": "ctrl+cmd+backspace",
    "command": "workbench.action.terminal.kill",
    "when": "terminalFocus && terminalHasBeenCreated"
  },
  {
    "key": "alt+cmd+\\",
    "command": "workbench.action.toggleMaximizedPanel"
  },
  {
    "key": "alt+f4",
    "command": "git.unstage"
  },
  {
    "key": "alt+f6",
    "command": "git.stage"
  },
  {
    "key": "ctrl+shift+alt+cmd+down",
    "command": "cursorMove",
    "args": {
      "to": "down",
      "by": "wrappedLine",
      "value": 8,
      "select": false
    },
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "ctrl+shift+alt+cmd+up",
    "command": "cursorMove",
    "args": {
      "to": "up",
      "by": "wrappedLine",
      "value": 8,
      "select": false
    },
    "when": "editorTextFocus && !editorReadonly"
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b\r"
    },
    "when": "terminalFocus"
  },
  {
    "key": "ctrl+shift+alt+cmd+c",
    "command": "claudeVSCodeSidebarSecondary.focus"
  },
  {
    "key": "ctrl+shift+alt+cmd+x",
    "command": "chatgpt.sidebarSecondaryView.focus"
  },
  {
    "key": "ctrl+shift+alt+cmd+right",
    "command": "workbench.action.nextAuxiliaryBarView"
  },
  {
    "key": "ctrl+shift+alt+cmd+left",
    "command": "workbench.action.previousAuxiliaryBarView"
  }
]
